include README.md
include LICENSE
include setup.py
include setup.cfg
include MANIFEST.in
recursive-include NiChart_SPARE *.py
# The CVM residualization table is loaded at runtime from
# NiChart_SPARE/reference/ and was absent from every built distribution.
recursive-include NiChart_SPARE/reference *.csv
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
